{
  "name": "find-my-legend",
  "version": "0.1.0",
  "private": true,
  "description": "나의 Riftbound 전설 찾기 — 플레이스타일 성향 테스트 + Legend 추천기",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:data": "vitest run tests/data.test.ts",
    "preview:build": "vite build --config preview/vite.config.ts",
    "data:fetch": "node scripts/fetch-riftcodex.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3",
    "vite": "8.3.0",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.0"
  },
  "type": "module"
}
